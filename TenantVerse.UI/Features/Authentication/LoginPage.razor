@page "/login"

@using MudBlazor
@using Blazored.LocalStorage
@using TenantVerse.Shared.Models
@using TenantVerse.Shared.Models.Authentication.Requests
@using TenantVerse.Shared.Models.Authentication.Responses
@using TenantVerse.UI.Services.Authentication
@* <PageTitle>Login</PageTitle> *@

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-10">

    <MudPaper Elevation="4" Class="pa-8">

        <MudText Typo="Typo.h4"
                 Align="Align.Center"
                 GutterBottom="true">
            Welcome Back
        </MudText>

        <MudText Typo="Typo.body2"
                 Align="Align.Center"
                 Class="mb-6">
            Sign in to TenantVerse
        </MudText>

        <MudForm @ref="_form">

            <MudGrid>

                <MudItem xs="12">

                    <MudTextField T="string"
                                  Label="Email"
                                  Variant="Variant.Outlined"
                                  InputType="InputType.Email"
                                  @bind-Value="_model.Email"
                                  Required="true" />

                </MudItem>

                <MudItem xs="12">

                    <MudTextField T="string"
                                  Label="Password"
                                  Variant="Variant.Outlined"
                                  InputType="InputType.Password"
                                  @bind-Value="_model.Password"
                                  Required="true" />

                </MudItem>

                <MudItem xs="12" Class="mt-4">

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               FullWidth="true"
                               Disabled="IsLoading"
                               OnClick="LoginAsync">

                        Login

                    </MudButton>

                </MudItem>

                <MudItem xs="12">

                    <MudDivider Class="my-4" />

                </MudItem>

                <MudItem xs="12">

                    <MudText Align="Align.Center">

                        Don't have an account?

                        <MudLink Href="/register">
                            Register
                        </MudLink>

                    </MudText>

                </MudItem>

                <MudItem xs="12">

                    <MudText Align="Align.Center">

                        <MudLink Href="/forgot-password">
                            Forgot Password?
                        </MudLink>

                    </MudText>

                </MudItem>

            </MudGrid>

        </MudForm>

    </MudPaper>

</MudContainer>

