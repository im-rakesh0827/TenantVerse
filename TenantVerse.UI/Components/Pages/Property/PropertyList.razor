@page "/property"
@inject IDialogService DialogService

<PageTitle>Properties</PageTitle>

<MudText Typo="Typo.h6" Class="mb-2">
    Property List - @TotalPropertyCount
</MudText>

<MudPaper Class="pa-2">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
        <MudItem xs="12" sm="6" md="4">

                    <MudTextField T="string"
                                   Label="Search"
                                   Placeholder="Search Property..."
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Immediate="true"
                                   Adornment="Adornment.Start"
                                   AdornmentIcon="@Icons.Material.Filled.Search"
                                   @bind-Value="SearchString" />
               </MudItem>
        <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add"
               OnClick="NavigateToCreate">
               Add Property
          </MudButton>
    </MudStack>
</MudPaper>

<MudPaper Class="mt-4 pa-2">

    @if (IsLoading)
    {
          <LoaderComponent Text="Loading Properties..."
                    Size="Size.Medium" />    
    }
    else
    {
        <MudTable Items="FilteredProperties"
                    Hover="true"
                    Dense="true"
                    Striped="true"
                    Bordered="true"
                    RowsPerPage="20">
          <HeaderContent>
               <MudTh>Code</MudTh>
               <MudTh>Name</MudTh>
               <MudTh>Owner</MudTh>
               <MudTh>City</MudTh>
               <MudTh>Floors</MudTh>
               <MudTh>Flats</MudTh>
               <MudTh>Email</MudTh>
               <MudTh>Status</MudTh>

               <MudTh>Actions</MudTh>
          </HeaderContent>
          <RowTemplate>

               <MudTd>@context.PropertyCode</MudTd>
               <MudTd>@context.PropertyName</MudTd>
               <MudTd>@context.OwnerName</MudTd>
               <MudTd>@context.City</MudTd>
               <MudTd>@context.TotalFloors</MudTd>
               <MudTd>@context.TotalFlats</MudTd>
               <MudTd>@context.Email</MudTd>

               <MudTd>
                    @if (context.IsActive)
                    {
                         <MudText Color="Color.Success">
                              ● Active
                         </MudText>
                    }
                    else
                    {
                         <MudText Color="Color.Error">
                              ● Inactive
                         </MudText>
                    }
               </MudTd>

               <MudTd>

                    <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                   Color="Color.Info"
                                   OnClick="@(() => UpdateOrView(context.PropertyId, false))" />

                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                   Color="Color.Primary"
                                   OnClick="@(() => UpdateOrView(context.PropertyId, true))" />

                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                   Color="Color.Error"
                                   OnClick="@(() => DeleteProperty(context.PropertyId))" />
               </MudTd>
          </RowTemplate>
          <PagerContent>
               <MudTablePager PageSizeOptions="new int[] { 5, 10, 20, 50, 100, 200, 500 }" />
          </PagerContent>
     </MudTable>
    }
</MudPaper>

