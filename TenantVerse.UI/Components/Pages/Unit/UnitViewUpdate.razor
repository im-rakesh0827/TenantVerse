@page "/flat/{mode}/{Id:int}"
@using MudBlazor

<PageTitle>
    @(IsViewMode ? "View Flat" : "Edit Flat")
</PageTitle>

<MudPaper Class="pa-6 flat-page-container">

    <MudText Typo="Typo.h4" Class="mb-6">
        @(IsViewMode ? "View Flat" : "Edit Flat")
    </MudText>
    <div class="flat-content">
        <MudForm @ref="_form">
            <MudGrid Spacing="3">

                <!-- PROPERTY -->
                <MudItem xs="12" md="6">
                    <MudSelect T="int"
                               Label="Property"
                               Variant="Variant.Outlined"
                               Value="_model.PropertyId"
                               ValueChanged="OnPropertyChanged"
                               Disabled="@IsViewMode"
                               Required="true"
                               RequiredError="Property is required.">

                        @foreach (var property in properties)
                        {
                            <MudSelectItem T="int"
                                           Value="@property.PropertyId">

                                @property.PropertyName

                            </MudSelectItem>
                        }

                    </MudSelect>
                </MudItem>


                <!-- FLAT NUMBER -->
                <MudItem xs="12" md="6">
                    <MudTextField T="string"
                                  Label="Flat Number"
                                  Variant="Variant.Outlined"
                                  @bind-Value="_model.UnitNumber"
                                  Disabled="@IsViewMode"
                                  Required="true"
                                  RequiredError="Flat number is required." />
                </MudItem>


                <!-- FLAT TYPE -->
                <MudItem xs="12" md="6">
                    <MudTextField T="string"
                                  Label="Flat Type"
                                  Variant="Variant.Outlined"
                                  Placeholder="Example: 2BHK"
                                  @bind-Value="_model.UnitType"
                                  Disabled="@IsViewMode" />
                </MudItem>


                <!-- FLOOR -->
                <MudItem xs="12" md="6">
                    <MudSelect T="int?"
                               Label="Floor Number"
                               Variant="Variant.Outlined"
                               @bind-Value="_model.FloorNumber"
                               Disabled="@(IsViewMode || IsFloorDisabled)"
                               Required="true"
                               RequiredError="Floor number is required.">

                        @foreach (var floor in _floors)
                        {
                            <MudSelectItem T="int?"
                                           Value="@((int?)floor.Value)">

                                @floor.Key

                            </MudSelectItem>
                        }

                    </MudSelect>
                </MudItem>


                <!-- BEDROOMS -->
                <MudItem xs="12" md="6">
                    <MudNumericField T="int?"
                                     Label="Bedrooms"
                                     Variant="Variant.Outlined"
                                     @bind-Value="_model.Bedrooms"
                                     Disabled="@IsViewMode"
                                     Min="0" />
                </MudItem>


                <!-- BATHROOMS -->
                <MudItem xs="12" md="6">
                    <MudNumericField T="int?"
                                     Label="Bathrooms"
                                     Variant="Variant.Outlined"
                                     @bind-Value="_model.Bathrooms"
                                     Disabled="@IsViewMode"
                                     Min="0" />
                </MudItem>


                <!-- AREA -->
                <MudItem xs="12" md="6">
                    <MudNumericField T="decimal?"
                                     Label="Area (sq.ft)"
                                     Variant="Variant.Outlined"
                                     @bind-Value="_model.Area"
                                     Disabled="@IsViewMode"
                                     Min="0" />
                </MudItem>


                <!-- MONTHLY RENT -->
                <MudItem xs="12" md="6">
                    <MudNumericField T="decimal?"
                                     Label="Monthly Rent"
                                     Variant="Variant.Outlined"
                                     Adornment="Adornment.Start"
                                     AdornmentText="₹"
                                     @bind-Value="_model.MonthlyRent"
                                     Disabled="@IsViewMode"
                                     Min="0" />
                </MudItem>


                <!-- SECURITY DEPOSIT -->
                <MudItem xs="12" md="6">
                    <MudNumericField T="decimal?"
                                     Label="Security Deposit"
                                     Variant="Variant.Outlined"
                                     Adornment="Adornment.Start"
                                     AdornmentText="₹"
                                     @bind-Value="_model.SecurityDeposit"
                                     Disabled="@IsViewMode"
                                     Min="0" />
                </MudItem>


                <!-- STATUS -->
                <MudItem xs="12" sm="6">
                    <MudSelect T="string"
                         Label="Status"
                         Variant="Variant.Outlined"
                         @bind-Value="_model.Status">
                         @foreach (var status in UnitStatus.StatusList)
                         {
                              <MudSelectItem T="string"
                                             Value="@status">
                                   @status
                              </MudSelectItem>
                         }
                    </MudSelect>
                </MudItem>

            </MudGrid>
            <MudDivider Class="my-6" />


            <!-- ACTIONS -->
            <MudStack Row="true"
                      Justify="Justify.FlexEnd"
                      Spacing="2">

                <MudButton Variant="Variant.Outlined"
                           Color="Color.Secondary"
                           Disabled="@(IsLoading)"
                           OnClick="GoBack">
                    Cancel
                </MudButton>
                <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Disabled="@(IsLoading || IsViewMode)"
                               StartIcon="@Icons.Material.Filled.Save"
                               OnClick="UpdateAsync">
                        Update Flat
                    </MudButton>
            </MudStack>
        </MudForm>
        @if (IsLoading)
        {
          <CustomLoaderComponent />
        }
    </div>
</MudPaper>