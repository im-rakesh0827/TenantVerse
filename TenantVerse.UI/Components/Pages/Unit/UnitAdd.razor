@page "/flat/add"

@using MudBlazor
@using TenantVerse.Shared.Models.Unit.Requests
<PageTitle>Add Flat</PageTitle>

<MudContainer MaxWidth="MaxWidth.False">

    <MudStack Row="true"
              AlignItems="AlignItems.Center"
              Class="mb-6">

        @* <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                       Color="Color.Default"
                       OnClick="GoBack" /> *@

        <div>
            <MudText Typo="Typo.h4">
                Add Flat
            </MudText>
            <MudText Typo="Typo.body2"
                     Color="Color.Secondary">
                Add a new flat to a property
            </MudText>
        </div>
    </MudStack>


    <MudPaper Elevation="1"
              Class="pa-6">

        <MudForm @ref="_form">

            <MudGrid Spacing="3">

                <!-- PROPERTY -->

                <MudItem xs="12" sm="6">
                    <MudAutocomplete T="int"
                                        Label="Property"
                                        Variant="Variant.Outlined"
                                        Value="_model.PropertyId"
                                        ValueChanged="OnPropertyChanged"
                                        SearchFunc="SearchProperties"
                                        ToStringFunc="GetPropertyName"
                                        ResetValueOnEmptyText="true"
                                        CoerceText="true"
                                        Clearable="true"
                                        Required="true"
                                        RequiredError="Property is required."
                                        Placeholder="Select Property"
                                        Disabled="@IsLoading"
                                        FullWidth="true" />
               </MudItem>


                <!-- UNIT NUMBER -->

                <MudItem xs="12" sm="6">

                    <MudTextField T="string"
                                  Label="Flat Number"
                                  Variant="Variant.Outlined"
                                  @bind-Value="_model.UnitNumber"
                                  Required="true"
                                  RequiredError="Flat number is required." />

                </MudItem>


                <!-- UNIT TYPE -->

                <MudItem xs="12" sm="6">
                    <MudTextField T="string"
                                  Label="Flat Type"
                                  Variant="Variant.Outlined"
                                  Placeholder="Example: 2BHK"
                                  @bind-Value="_model.UnitType" />
                </MudItem>


                <!-- FLOOR -->
                <MudItem xs="12" md="6">
                    <MudSelect T="int?"
                              Label="Floor Number"
                              Variant="Variant.Outlined"
                              @bind-Value="_model.FloorNumber"
                              Disabled="@(IsFloorDisabled)"
                              Required="true"
                              RequiredError="Floor number is required.">
                         @foreach (var floor in _floors)
                         {
                              <MudSelectItem T="int?"
                                             Value="@((int?)floor.Value)">
                              @floor.Key
                              </MudSelectItem>
                         }
                    </MudSelect>
               </MudItem>
                <!-- BEDROOMS -->

                <MudItem xs="12" sm="6">

                    <MudNumericField T="int?"
                                     Label="Bedrooms"
                                     Variant="Variant.Outlined"
                                     @bind-Value="_model.Bedrooms"
                                     Min="0" />
                </MudItem>

                <!-- BATHROOMS -->

                <MudItem xs="12" sm="6">
                    <MudNumericField T="int?"
                                     Label="Bathrooms"
                                     Variant="Variant.Outlined"
                                     @bind-Value="_model.Bathrooms"
                                     Min="0" />
                </MudItem>


                <!-- AREA -->
                <MudItem xs="12" sm="6">

                    <MudNumericField T="decimal?"
                                     Label="Area (sq.ft)"
                                     Variant="Variant.Outlined"
                                     @bind-Value="_model.Area"
                                     Min="0" />
                </MudItem>


                <!-- MONTHLY RENT -->

                <MudItem xs="12" sm="6">

                    <MudNumericField T="decimal?"
                                     Label="Monthly Rent"
                                     Variant="Variant.Outlined"
                                     Adornment="Adornment.Start"
                                     AdornmentText="₹"
                                     @bind-Value="_model.MonthlyRent"
                                     Min="0" />
                </MudItem>


                <!-- SECURITY DEPOSIT -->

                <MudItem xs="12" sm="6">
                    <MudNumericField T="decimal?"
                                     Label="Security Deposit"
                                     Variant="Variant.Outlined"
                                     Adornment="Adornment.Start"
                                     AdornmentText="₹"
                                     @bind-Value="_model.SecurityDeposit"
                                     Min="0" />
                </MudItem>


                <!-- STATUS -->
                <MudItem xs="12" sm="6">
                    <MudSelect T="string"
                         Label="Status"
                         Variant="Variant.Outlined"
                         @bind-Value="_model.Status">
                         @foreach (var status in UnitStatus.StatusList)
                         {
                              <MudSelectItem T="string"
                                             Value="@status">
                                   @status
                              </MudSelectItem>
                         }
                    </MudSelect>
                </MudItem>

                <!-- ACTIONS -->
                <MudItem xs="12">
                    <MudDivider Class="my-4" />
                    <MudStack Row="true"
                              Justify="Justify.FlexEnd"
                              Spacing="2">
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Default"
                                   Disabled="@IsLoading"
                                   OnClick="GoBack">
                            Cancel
                        </MudButton>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Disabled="@IsLoading"
                                   StartIcon="@Icons.Material.Filled.Save"
                                   OnClick="SaveAsync">
                            Save Flat
                        </MudButton>
                    </MudStack>
                </MudItem>
            </MudGrid>
        </MudForm>
        @if (IsLoading)
        {
          <CustomLoaderComponent />
        }
    </MudPaper>
</MudContainer>