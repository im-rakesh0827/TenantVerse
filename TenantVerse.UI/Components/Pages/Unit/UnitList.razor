@page "/flat"
@using MudBlazor
@using TenantVerse.Shared.Models.Unit

<PageTitle>Flats</PageTitle>

<MudText Typo="Typo.h6" Class="mb-2">
    Flat List - @FilteredUnits.ToList().Count()
</MudText>

<MudPaper Class="pa-2">

    <MudStack Row="true"
              Justify="Justify.SpaceBetween"
              AlignItems="AlignItems.Center">

        <MudItem xs="12" sm="6" md="4">

            <MudTextField T="string"
                          Label="Search"
                          Placeholder="Search Flat..."
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Immediate="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          @bind-Value="_searchString" />

        </MudItem>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="AddUnit">

            Add Flat

        </MudButton>

    </MudStack>

</MudPaper>


<MudPaper Class="mt-4 pa-2">

    @if (_isLoading)
    {
        <CustomLoaderComponent />
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <MudAlert Severity="Severity.Error"
                  Variant="Variant.Outlined"
                  Class="ma-2">

            @_errorMessage

        </MudAlert>
    }
    else
    {
        <MudTable T="UnitModel"
                  Items="FilteredUnits"
                  Hover="true"
                  Dense="true"
                  Striped="true"
                  Bordered="true"
                  RowsPerPage="20">

            <HeaderContent>

                <MudTh>Flat</MudTh>
                <MudTh>Property</MudTh>
                <MudTh>Type</MudTh>
                <MudTh>Floor</MudTh>
                <MudTh>Bedrooms</MudTh>
                <MudTh>Bathrooms</MudTh>
                <MudTh>Area</MudTh>
                <MudTh>Rent</MudTh>
                <MudTh>Status</MudTh>
                <MudTh>Actions</MudTh>

            </HeaderContent>


            <RowTemplate>

                <!-- FLAT -->

                <MudTd DataLabel="Flat">

                    <MudText Typo="Typo.body2">
                        <b>@context.UnitNumber</b>
                    </MudText>

                </MudTd>


                <!-- PROPERTY -->

                <MudTd DataLabel="Property">

                    @(string.IsNullOrWhiteSpace(context.PropertyName)
                        ? "-"
                        : context.PropertyName)

                </MudTd>


                <!-- TYPE -->

                <MudTd DataLabel="Type">

                    @(string.IsNullOrWhiteSpace(context.UnitType)
                        ? "-"
                        : context.UnitType)

                </MudTd>


                <!-- FLOOR -->

                <MudTd DataLabel="Floor">

                    @if (context.FloorNumber.HasValue)
                    {
                        @if (context.FloorNumber.Value == 0)
                        {
                            <span>G</span>
                        }
                        else
                        {
                            <span>
                                @context.FloorNumber.Value
                            </span>
                        }
                    }
                    else
                    {
                        <span>-</span>
                    }

                </MudTd>


                <!-- BEDROOMS -->

                <MudTd DataLabel="Bedrooms">

                    @(context.Bedrooms?.ToString() ?? "-")

                </MudTd>


                <!-- BATHROOMS -->

                <MudTd DataLabel="Bathrooms">

                    @(context.Bathrooms?.ToString() ?? "-")

                </MudTd>


                <!-- AREA -->

                <MudTd DataLabel="Area">

                    @(context.Area.HasValue
                        ? $"{context.Area.Value:N0} sq.ft"
                        : "-")

                </MudTd>


                <!-- RENT -->

                <MudTd DataLabel="Rent">

                    @(context.MonthlyRent.HasValue
                        ? $"₹{context.MonthlyRent.Value:N0}"
                        : "-")

                </MudTd>


                <!-- STATUS -->

                <MudTd DataLabel="Status">

                    @if (context.Status == "Available")
                    {
                        <MudText Color="Color.Success">
                            ● Available
                        </MudText>
                    }
                    else if (context.Status == "Occupied")
                    {
                        <MudText Color="Color.Error">
                            ● Occupied
                        </MudText>
                    }
                    else if (context.Status == "Maintenance")
                    {
                        <MudText Color="Color.Warning">
                            ● Maintenance
                        </MudText>
                    }
                    else
                    {
                        <MudText Color="Color.Default">
                            ● @(string.IsNullOrWhiteSpace(context.Status)
                                ? "Unknown"
                                : context.Status)
                        </MudText>
                    }

                </MudTd>


                <!-- ACTIONS -->

                <MudTd DataLabel="Actions">

                    <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                   Color="Color.Info"
                                   OnClick="@(() => EditOrViewUnit(context.UnitId, "view"))" />

                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                   Color="Color.Primary"
                                   OnClick="@(() => EditOrViewUnit(context.UnitId, "edit"))" />

                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                   Color="Color.Error"
                                   OnClick="@(() => DeleteUnit(context.UnitId))" />
                </MudTd>

            </RowTemplate>

            <PagerContent>

                <MudTablePager PageSizeOptions="new int[] { 5, 10, 20, 50, 100, 200, 500 }" />

            </PagerContent>

        </MudTable>
    }

</MudPaper>