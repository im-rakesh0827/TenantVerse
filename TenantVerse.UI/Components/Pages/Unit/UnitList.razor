@page "/flat"

@using MudBlazor
@using TenantVerse.Shared.Models.Unit

<PageTitle>Flats</PageTitle>

<MudText Typo="Typo.h6" Class="mb-2">
    Flat List - @FilteredUnits.Count()
</MudText>

<!-- =========================
     HEADER / SEARCH
     ========================= -->

<MudPaper Class="pa-2">

    @* <MudStack Row="true"
              Justify="Justify.SpaceBetween"
              AlignItems="AlignItems.Center">

        <MudItem xs="12"
                 sm="6"
                 md="4">

            <MudTextField T="string"
                          Label="Search"
                          Placeholder="Search Flat..."
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Immediate="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          @bind-Value="_searchString" />

        </MudItem>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="AddUnit">

            Add Flat

        </MudButton>

    </MudStack> *@


    <MudStack Row="true"
          AlignItems="AlignItems.Center"
          Spacing="2">

    <!-- SEARCH -->

    <MudItem xs="12"
             sm="6"
             md="4">

        <MudTextField T="string"
                      Label="Search"
                      Placeholder="Search Flat..."
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Immediate="true"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      @bind-Value="_searchString" />

    </MudItem>


    <!-- STATUS -->

    <MudItem xs="12"
             sm="4"
             md="3">

        <MudSelect T="string"
                   Label="Status"
                   Variant="Variant.Outlined"
                   Margin="Margin.Dense"
                   Clearable="false"
                   @bind-Value="_flatStatus">

            @foreach (var status in UnitStatus.FilterStatusList)
            {
                <MudSelectItem T="string"
                               Value="@status">

                    @status

                </MudSelectItem>
            }

        </MudSelect>

    </MudItem>
    


    <!-- CREATE -->

    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add"
               OnClick="AddUnit"
               Style="margin-left:auto;">

        Create

    </MudButton>

</MudStack>

</MudPaper>


<!-- =========================
     GRID CONTAINER
     ========================= -->

<MudPaper Class="mt-4 pa-2"
          Style="position:relative;">

    <!-- =========================
         ERROR
         ========================= -->

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <MudAlert Severity="Severity.Error"
                  Variant="Variant.Outlined"
                  Class="ma-2">

            @_errorMessage

        </MudAlert>
    }


    <!-- =========================
         GRID
         ========================= -->

    @if (string.IsNullOrWhiteSpace(_errorMessage))
    {
        <MudTable T="UnitModel"
                  Items="FilteredUnits"
                  Hover="true"
                  Dense="true"
                  Striped="true"
                  Bordered="true"
                  RowsPerPage="20">

            <HeaderContent>

                <MudTh>Flat</MudTh>
                <MudTh>Property</MudTh>
                <MudTh>Type</MudTh>
                <MudTh>Floor</MudTh>
                <MudTh>Bedrooms</MudTh>
                <MudTh>Bathrooms</MudTh>
                <MudTh>Area</MudTh>
                <MudTh>Rent</MudTh>
                <MudTh>Status</MudTh>
                <MudTh>Actions</MudTh>

            </HeaderContent>


            <RowTemplate>

                <!-- FLAT -->

                <MudTd DataLabel="Flat">

                    <MudText Typo="Typo.body2">
                        <b>@context.UnitNumber</b>
                    </MudText>

                </MudTd>


                <!-- PROPERTY -->

                <MudTd DataLabel="Property">

                    @(string.IsNullOrWhiteSpace(context.PropertyName)
                        ? "-"
                        : context.PropertyName)

                </MudTd>


                <!-- TYPE -->

                <MudTd DataLabel="Type">

                    @(string.IsNullOrWhiteSpace(context.UnitType)
                        ? "-"
                        : context.UnitType)

                </MudTd>


                <!-- FLOOR -->

                <MudTd DataLabel="Floor">

                    @(context.FloorNumber.HasValue
                        ? context.FloorNumber.Value == 0
                            ? "G"
                            : context.FloorNumber.Value.ToString()
                        : "-")

                </MudTd>


                <!-- BEDROOMS -->

                <MudTd DataLabel="Bedrooms">

                    @(context.Bedrooms?.ToString() ?? "-")

                </MudTd>


                <!-- BATHROOMS -->

                <MudTd DataLabel="Bathrooms">

                    @(context.Bathrooms?.ToString() ?? "-")

                </MudTd>


                <!-- AREA -->

                <MudTd DataLabel="Area">

                    @(context.Area.HasValue
                        ? $"{context.Area.Value:N0} sq.ft"
                        : "-")

                </MudTd>


                <!-- RENT -->

                <MudTd DataLabel="Rent">

                    @(context.MonthlyRent.HasValue
                        ? $"₹{context.MonthlyRent.Value:N0}"
                        : "-")

                </MudTd>


                <!-- STATUS -->

                @* <MudTd DataLabel="Status">
                        <MudText Color="@StatusColor.GetStatusColor(context.Status)">
                            ● @context.Status
                        </MudText>
                </MudTd> *@


                <MudTd DataLabel="Status">

                    <MudStack Row="true"
                            AlignItems="AlignItems.Center"
                            Spacing="1">

                        <MudIcon Icon="@StatusIcon.GetStatusIcon(context.Status)"
                                Color="@StatusColor.GetStatusColor(context.Status)"
                                Size="Size.Small" />

                        <MudText Color="@StatusColor.GetStatusColor(context.Status)">
                            @context.Status
                        </MudText>

                    </MudStack>

                </MudTd>

                <!-- ACTIONS -->

                <MudTd DataLabel="Actions">

                    <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                   Color="Color.Info"
                                   Size="Size.Small"
                                   OnClick="@(() => EditOrViewUnit(
                                       context.UnitId,
                                       "view"))" />

                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   OnClick="@(() => EditOrViewUnit(
                                       context.UnitId,
                                       "edit"))" />

                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                   Color="Color.Error"
                                   Size="Size.Small"
                                   OnClick="@(() => DeleteUnit(
                                       context.UnitId))" />

                </MudTd>

            </RowTemplate>


            <NoRecordsContent>
               <MudText Color="Color.Secondary"
                    Class="pa-4">
                    @(IsLoading ? "Loading..." : "No record found.")
               </MudText>
            </NoRecordsContent>


            <!-- =========================
                 PAGINATION
                 ========================= -->

            <PagerContent>

                <MudTablePager PageSizeOptions="new int[]
                {5, 10, 20, 50, 100, 200, 500}" />

            </PagerContent>

        </MudTable>
    }


    <!-- =========================
         LOADING OVERLAY
         ========================= -->

    @if (IsLoading)
    {
      <CustomLoaderComponent />
    }

</MudPaper>