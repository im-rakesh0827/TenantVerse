@page "/tenant/create"
<PageTitle>Add Tenant</PageTitle>

<MudContainer MaxWidth="MaxWidth.False">

    <MudStack Row="true"
              AlignItems="AlignItems.Center"
              Class="mb-6">

        <div>

            <MudText Typo="Typo.h4">
                Add Tenant
            </MudText>

            <MudText Typo="Typo.body2"
                     Color="Color.Secondary">

                Add a new tenant and assign a flat

            </MudText>


            @* @if(_model.UnitId!=0){
               <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   Disabled="@IsLoading"
                                   OnClick="GetFlatDetails">
                            Flat Details
                        </MudButton>
            } *@

        </div>

    </MudStack>


    <MudPaper Elevation="1"
              Class="pa-6">

        <MudForm @ref="_form">

            <MudGrid Spacing="3">


                <!-- =========================
                     PROPERTY
                     ========================= -->

                <MudItem xs="12"
                         sm="6">
                    <MudSelect T="int"
                               Label="Property"
                               Variant="Variant.Outlined"
                               Value="_model.PropertyId"
                               ValueChanged="OnPropertyChanged"
                               Required="true"
                               RequiredError="Property is required."
                               Placeholder="Select Property"
                               Disabled="@IsLoading"
                               ToStringFunc="GetPropertyName">

                        @foreach (var property in _properties)
                        {
                            <MudSelectItem T="int"
                                           Value="@property.PropertyId">

                                @property.PropertyName

                            </MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>


                <!-- =========================
                     FLAT
                     ========================= -->

                <MudItem xs="12"
                         sm="6">

                    <MudSelect T="int"
                         Label="Flat"
                         Variant="Variant.Outlined"
                         Value="_model.UnitId"
                         ValueChanged="OnUnitChanged"
                         Required="true"
                         RequiredError="Flat is required."
                         Disabled="@(IsLoading || IsLoadingFlats || !_availableUnits.Any())"
                         ToStringFunc="GetUnitDisplayName">

                             @if (!IsLoadingFlats && _availableUnits.Any())
                             {
                                  @foreach (var unit in _availableUnits)
                                  {
                                       <MudSelectItem T="int"
                                                      Value="@unit.UnitId">

                                            @unit.UnitNumber

                                       </MudSelectItem>
                                  }
                             }

                             </MudSelect>
                </MudItem>


                <!-- =========================
                     FIRST NAME
                     ========================= -->

                <MudItem xs="12"
                         sm="6">

                    <MudTextField T="string"
                                  Label="First Name"
                                  Variant="Variant.Outlined"
                                  @bind-Value="_model.FirstName"
                                  Required="true"
                                  RequiredError="First name is required." />

                </MudItem>


                <!-- =========================
                     LAST NAME
                     ========================= -->

                <MudItem xs="12"
                         sm="6">

                    <MudTextField T="string"
                                  Label="Last Name"
                                  Variant="Variant.Outlined"
                                  @bind-Value="_model.LastName" />

                </MudItem>


                <!-- =========================
                     EMAIL
                     ========================= -->

                <MudItem xs="12"
                         sm="6">

                    <MudTextField T="string"
                                  Label="Email"
                                  Variant="Variant.Outlined"
                                  InputType="InputType.Email"
                                  @bind-Value="_model.Email" />

                </MudItem>


                <!-- =========================
                     PHONE
                     ========================= -->

                <MudItem xs="12"
                         sm="6">

                    <MudTextField T="string"
                                  Label="Phone Number"
                                  Variant="Variant.Outlined"
                                  @bind-Value="_model.PhoneNumber" />

                </MudItem>


                <!-- =========================
                     EMERGENCY CONTACT
                     ========================= -->

                <MudItem xs="12"
                         sm="6">

                    <MudTextField T="string"
                                  Label="Emergency Contact Name"
                                  Variant="Variant.Outlined"
                                  @bind-Value="_model.EmergencyContactName" />

                </MudItem>


                <!-- =========================
                     EMERGENCY PHONE
                     ========================= -->

                <MudItem xs="12"
                         sm="6">

                    <MudTextField T="string"
                                  Label="Emergency Contact Phone"
                                  Variant="Variant.Outlined"
                                  @bind-Value="_model.EmergencyContactPhone" />

                </MudItem>


                <!-- =========================
                     LEASE START DATE
                     ========================= -->

                <MudItem xs="12"
                         sm="6">

                    <MudDatePicker Label="Lease Start Date"
                                   Variant="Variant.Outlined"
                                   @bind-Date="_model.LeaseStartDate" />

                </MudItem>


                <!-- =========================
                     LEASE END DATE
                     ========================= -->

                <MudItem xs="12"
                         sm="6">

                    <MudDatePicker Label="Lease End Date"
                                   Variant="Variant.Outlined"
                                   @bind-Date="_model.LeaseEndDate" />

                </MudItem>


                <!-- =========================
                     MONTHLY RENT
                     ========================= -->

                <MudItem xs="12"
                         sm="6">

                    <MudNumericField T="decimal?"
                                     Label="Monthly Rent"
                                     Variant="Variant.Outlined"
                                     Adornment="Adornment.Start"
                                     AdornmentText="₹"
                                     @bind-Value="_model.MonthlyRent"
                                     Min="0" />

                </MudItem>


                <!-- =========================
                     SECURITY DEPOSIT
                     ========================= -->

                <MudItem xs="12"
                         sm="6">

                    <MudNumericField T="decimal?"
                                     Label="Security Deposit"
                                     Variant="Variant.Outlined"
                                     Adornment="Adornment.Start"
                                     AdornmentText="₹"
                                     @bind-Value="_model.SecurityDeposit"
                                     Min="0" />

                </MudItem>


                <!-- =========================
                     STATUS
                     ========================= -->

                <MudItem xs="12"
                         sm="6">

                    <MudSelect T="string"
                               Label="Status"
                               Variant="Variant.Outlined"
                               @bind-Value="_model.Status"
                               Required="true"
                               RequiredError="Status is required.">

                        @foreach (var status in TenantStatus.StatusList)
                        {
                            <MudSelectItem T="string"
                                           Value="@status">

                                @status

                            </MudSelectItem>
                        }

                    </MudSelect>

                </MudItem>


                <!-- =========================
                     ACTIONS
                     ========================= -->

                <MudItem xs="12">

                    <MudDivider Class="my-4" />

                    <MudStack Row="true"
                              Justify="Justify.FlexEnd"
                              Spacing="2">

                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Default"
                                   Disabled="@IsLoading"
                                   OnClick="GoBack">

                            Cancel

                        </MudButton>


                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Disabled="@IsLoading"
                                   StartIcon="@Icons.Material.Filled.Save"
                                   OnClick="SaveAsync">

                            Save Tenant

                        </MudButton>

                    </MudStack>

                </MudItem>

            </MudGrid>

        </MudForm>


        <!-- =========================
             LOADER
             ========================= -->

        @if (IsLoading)
        {
            <CustomLoaderComponent />
        }

    </MudPaper>

</MudContainer>