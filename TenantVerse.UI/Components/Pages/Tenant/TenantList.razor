@page "/tenant"
<PageTitle>Tenants</PageTitle>

<MudText Typo="Typo.h6" Class="mb-2">
    Tenant List - @FilteredTenants.Count()
</MudText>


<!-- =========================
     HEADER / SEARCH
     ========================= -->

<MudPaper Class="pa-2">

    <MudStack Row="true"
              Justify="Justify.SpaceBetween"
              AlignItems="AlignItems.Center">

        <MudItem xs="12"
                 sm="6"
                 md="4">

            <MudTextField T="string"
                          Label="Search"
                          Placeholder="Search Tenant..."
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Immediate="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          @bind-Value="_searchString" />

        </MudItem>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="AddTenant">

            Add Tenant

        </MudButton>

    </MudStack>

</MudPaper>


<!-- =========================
     GRID CONTAINER
     ========================= -->

<MudPaper Class="mt-4 pa-2"
          Style="position:relative;">

    <!-- =========================
         ERROR
         ========================= -->

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <MudAlert Severity="Severity.Error"
                  Variant="Variant.Outlined"
                  Class="ma-2">

            @_message

        </MudAlert>
    }


    <!-- =========================
         GRID
         ========================= -->

    @if (string.IsNullOrWhiteSpace(_message))
    {
        <MudTable T="TenantVerse.Shared.Models.Tenant.TenantModel"
                  Items="FilteredTenants"
                  Hover="true"
                  Dense="true"
                  Striped="true"
                  Bordered="true"
                  RowsPerPage="20">

            <HeaderContent>

                <MudTh>Tenant</MudTh>
                <MudTh>Property</MudTh>
                <MudTh>Flat</MudTh>
                <MudTh>Phone</MudTh>
                <MudTh>Email</MudTh>
                <MudTh>Lease Start</MudTh>
                <MudTh>Rent</MudTh>
                <MudTh>Status</MudTh>
                <MudTh>Actions</MudTh>

            </HeaderContent>


            <RowTemplate>

                <!-- TENANT -->

                <MudTd DataLabel="Tenant">

                    <MudText Typo="Typo.body2">
                        <b>
                            @context.FirstName
                            @context.LastName
                        </b>
                    </MudText>

                </MudTd>


                <!-- PROPERTY -->

                <MudTd DataLabel="Property">

                    @(string.IsNullOrWhiteSpace(context.PropertyName)
                        ? "-"
                        : context.PropertyName)

                </MudTd>


                <!-- FLAT -->

                <MudTd DataLabel="Flat">

                    @(string.IsNullOrWhiteSpace(context.UnitNumber)
                        ? "-"
                        : context.UnitNumber)

                </MudTd>


                <!-- PHONE -->

                <MudTd DataLabel="Phone">

                    @(string.IsNullOrWhiteSpace(context.PhoneNumber)
                        ? "-"
                        : context.PhoneNumber)

                </MudTd>


                <!-- EMAIL -->

                <MudTd DataLabel="Email">

                    @(string.IsNullOrWhiteSpace(context.Email)
                        ? "-"
                        : context.Email)

                </MudTd>


                <!-- LEASE START -->

                <MudTd DataLabel="Lease Start">

                    @(context.LeaseStartDate.HasValue
                        ? context.LeaseStartDate.Value.ToString("dd MMM yyyy")
                        : "-")


                </MudTd>


                <!-- RENT -->

                <MudTd DataLabel="Rent">

                    @(context.MonthlyRent.HasValue
                        ? $"₹{context.MonthlyRent.Value:N0}"
                        : "-")

                </MudTd>


                <!-- STATUS -->

                <MudTd DataLabel="Status">

                    @if (context.Status == "Active")
                    {
                        <MudText Color="Color.Success">
                            ● Active
                        </MudText>
                    }
                    else if (context.Status == "Pending")
                    {
                        <MudText Color="Color.Warning">
                            ● Pending
                        </MudText>
                    }
                    else if (context.Status == "Inactive")
                    {
                        <MudText Color="Color.Error">
                            ● Inactive
                        </MudText>
                    }
                    else
                    {
                        <MudText Color="Color.Default">
                            ● @(string.IsNullOrWhiteSpace(context.Status)
                                ? "Unknown"
                                : context.Status)
                        </MudText>
                    }

                </MudTd>


                <!-- ACTIONS -->

                <MudTd DataLabel="Actions">

                    <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                   Color="Color.Info"
                                   Size="Size.Small"
                                   OnClick="@(() => EditOrViewTenant(
                                       context.TenantId,
                                       "view"))" />

                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   OnClick="@(() => EditOrViewTenant(
                                       context.TenantId,
                                       "edit"))" />

                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                   Color="Color.Error"
                                   Size="Size.Small"
                                   OnClick="@(() => DeleteTenant(context.TenantId))" />
                </MudTd>

            </RowTemplate>


            <!-- =========================
                 PAGINATION
                 ========================= -->

            <PagerContent>

                <MudTablePager PageSizeOptions="new int[]
                {5, 10, 20, 50, 100, 200, 500}" />

            </PagerContent>

        </MudTable>
    }


    <!-- =========================
         LOADING OVERLAY
         ========================= -->

    @if (IsLoading)
    {
        <CustomLoaderComponent />
    }

</MudPaper>