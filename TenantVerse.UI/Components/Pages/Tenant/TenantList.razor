@page "/tenant"
<PageTitle>Tenants</PageTitle>

<MudText Typo="Typo.h6" Class="mb-2">
    Tenant List - @FilteredTenants.Count()
</MudText>


<!-- =========================
     HEADER / SEARCH
     ========================= -->

<MudPaper Class="pa-2">

    <MudStack Row="true"
          AlignItems="AlignItems.Center"
          Spacing="2">

    <!-- SEARCH -->

    <MudItem xs="12"
             sm="6"
             md="4">

        <MudTextField T="string"
                      Label="Search"
                      Placeholder="Search Tenant..."
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Immediate="true"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      @bind-Value="_searchString" />

    </MudItem>


    <!-- Property -->

    @* <MudItem xs="12" sm="6">
                    <MudAutocomplete T="int"
                                        Label="Property"
                                        Variant="Variant.Outlined"
                                        Value="_model.PropertyId"
                                        ValueChanged="OnPropertyChanged"
                                        SearchFunc="SearchProperties"
                                        ToStringFunc="GetPropertyName"
                                        ResetValueOnEmptyText="true"
                                        CoerceText="true"
                                        Clearable="true"
                                        Required="true"
                                        RequiredError="Property is required."
                                        Placeholder="Select Property"
                                        Disabled="@IsLoading"
                                        FullWidth="true" />
               </MudItem> *@




    <MudItem xs="12"
             sm="4"
             md="3">

        <MudSelect T="string"
                   Label="Status"
                   Variant="Variant.Outlined"
                   Margin="Margin.Dense"
                   Clearable="false"
                   @bind-Value="_tenantStatus">

            @foreach (var status in TenantStatus.FilterStatusList)
            {
                <MudSelectItem T="string"
                               Value="@status">

                    @status

                </MudSelectItem>
            }

        </MudSelect>

    </MudItem>


    <!-- CREATE -->

    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add"
               OnClick="AddTenant"
               Style="margin-left:auto;">

        Create

    </MudButton>

</MudStack>

</MudPaper>


<!-- =========================
     GRID CONTAINER
     ========================= -->

<MudPaper Class="mt-4 pa-2"
          Style="position:relative;">

    <!-- =========================
         ERROR
         ========================= -->

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <MudAlert Severity="Severity.Error"
                  Variant="Variant.Outlined"
                  Class="ma-2">

            @_message

        </MudAlert>
    }


    <!-- =========================
         GRID
         ========================= -->

    @if (string.IsNullOrWhiteSpace(_message))
    {
        <MudTable T="TenantVerse.Shared.Models.Tenant.TenantModel"
                  Items="FilteredTenants"
                  Hover="true"
                  Dense="true"
                  Striped="true"
                  Bordered="true"
                  RowsPerPage="20">

            <HeaderContent>

                <MudTh>Tenant</MudTh>
                <MudTh>Property</MudTh>
                <MudTh>Flat</MudTh>
                <MudTh>Phone</MudTh>
                <MudTh>Email</MudTh>
                <MudTh>Lease Start</MudTh>
                <MudTh>Rent</MudTh>
                <MudTh>Status</MudTh>
                <MudTh>Actions</MudTh>

            </HeaderContent>


            <RowTemplate>

                <!-- TENANT -->

                <MudTd DataLabel="Tenant">

                    <MudText Typo="Typo.body2">
                        <b>
                            @context.FirstName
                            @context.LastName
                        </b>
                    </MudText>

                </MudTd>


                <!-- PROPERTY -->

                <MudTd DataLabel="Property">

                    @(string.IsNullOrWhiteSpace(context.PropertyName)
                        ? "-"
                        : context.PropertyName)

                </MudTd>


                <!-- FLAT -->

                <MudTd DataLabel="Flat">

                    @(string.IsNullOrWhiteSpace(context.UnitNumber)
                        ? "-"
                        : context.UnitNumber)

                </MudTd>


                <!-- PHONE -->

                <MudTd DataLabel="Phone">

                    @(string.IsNullOrWhiteSpace(context.PhoneNumber)
                        ? "-"
                        : context.PhoneNumber)

                </MudTd>


                <!-- EMAIL -->

                <MudTd DataLabel="Email">

                    @(string.IsNullOrWhiteSpace(context.Email)
                        ? "-"
                        : context.Email)

                </MudTd>


                <!-- LEASE START -->

                <MudTd DataLabel="Lease Start">

                    @(context.LeaseStartDate.HasValue
                        ? context.LeaseStartDate.Value.ToString("dd MMM yyyy")
                        : "-")


                </MudTd>


                <!-- RENT -->

                <MudTd DataLabel="Rent">

                    @(context.MonthlyRent.HasValue
                        ? $"₹{context.MonthlyRent.Value:N0}"
                        : "-")

                </MudTd>


                <!-- STATUS -->

                @* <MudTd DataLabel="Status">
                    <MudText Color="@StatusColor.GetStatusColor(context.Status)">
                        ● @context.Status
                    </MudText>
                </MudTd> *@



                <MudTd DataLabel="Status">

                    <MudStack Row="true"
                            AlignItems="AlignItems.Center"
                            Spacing="1">

                        <MudIcon Icon="@StatusIcon.GetStatusIcon(context.Status)"
                                Color="@StatusColor.GetStatusColor(context.Status)"
                                Size="Size.Small" />

                        <MudText Color="@StatusColor.GetStatusColor(context.Status)">
                            @context.Status
                        </MudText>

                    </MudStack>

                </MudTd>





                <!-- ACTIONS -->

                <MudTd DataLabel="Actions">

                    <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                   Color="Color.Info"
                                   Size="Size.Small"
                                   OnClick="@(() => EditOrViewTenant(
                                       context.TenantId,
                                       "view"))" />

                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   OnClick="@(() => EditOrViewTenant(
                                       context.TenantId,
                                       "edit"))" />

                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                   Color="Color.Error"
                                   Size="Size.Small"
                                   OnClick="@(() => DeleteTenant(context.TenantId))" />
                </MudTd>

            </RowTemplate>


            <NoRecordsContent>
               <MudText Color="Color.Secondary"
                    Class="pa-4">
                    @(IsLoading ? "Loading..." : "No record found.")
               </MudText>
            </NoRecordsContent>


            <!-- =========================
                 PAGINATION
                 ========================= -->

            <PagerContent>

                <MudTablePager PageSizeOptions="new int[]
                {5, 10, 20, 50, 100, 200, 500}" />

            </PagerContent>

        </MudTable>
    }


    <!-- =========================
         LOADING OVERLAY
         ========================= -->

    @if (IsLoading)
    {
        <CustomLoaderComponent />
    }

</MudPaper>