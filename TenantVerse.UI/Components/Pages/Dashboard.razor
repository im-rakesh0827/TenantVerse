@page "/dashboard"
@* @attribute [Authorize] *@

<PageTitle>Dashboard</PageTitle>
<MudText Typo="Typo.h4" Class="mb-4">
    Dashboard
</MudText>
<!-- Dashboard Cards -->
<MudGrid>
    <!-- Total Properties -->
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Elevation="1"
                Class="pa-4">
            <MudGrid>
                <MudItem xs="6">
                    <MudText Typo="Typo.subtitle2"
                            Color="Color.Secondary">
                        Properties
                    </MudText>
                    <MudText Typo="Typo.h5"
                            Class="mt-1">
                        @TotalProperties.ToString("N0")
                    </MudText>
                </MudItem>


                <MudItem xs="6">
                    <MudText Typo="Typo.subtitle2"
                            Color="Color.Secondary">
                        Flats
                    </MudText>

                    <MudText Typo="Typo.h5"
                            Class="mt-1">
                        @TotalFlats.ToString("N0")
                    </MudText>
                </MudItem>
            </MudGrid>
        </MudPaper>
    </MudItem>

    <!-- Total Flats -->
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4">

            <MudText Typo="Typo.subtitle2" Color="Color.Secondary">
                Active Flats
            </MudText>

            <MudText Typo="Typo.h5">
                @TotalActiveFlats.ToString("N0")
            </MudText>

        </MudPaper>
    </MudItem>

    <!-- Active Tenants -->
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4">

            <MudText Typo="Typo.subtitle2" Color="Color.Secondary">
                Active Tenants
            </MudText>

            <MudText Typo="Typo.h5">
                @ActiveTenants
            </MudText>

        </MudPaper>
    </MudItem>

    <!-- Pending Payments -->
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4">

            <MudText Typo="Typo.subtitle2" Color="Color.Secondary">
                Pending Payments
            </MudText>

            <MudText Typo="Typo.h5">
                ₹@PendingPayments.ToString("N0")
            </MudText>

        </MudPaper>
    </MudItem>

</MudGrid>

<MudDivider Class="my-6" />

<!-- Recent Properties -->
<MudPaper Class="pa-4">
    <MudText Typo="Typo.h6" Class="mb-3">
        Recent Properties(Top 5)
    </MudText>
    <MudTable Items="_properties"
                Hover="true"
                Dense="true"
                Striped="true"
                Bordered="true"
                RowsPerPage="5">

        <HeaderContent>
            <MudTh>Code</MudTh>
            <MudTh>Name</MudTh>
            <MudTh>Owner</MudTh>
            <MudTh>City</MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd>@context.PropertyCode</MudTd>
            <MudTd>@context.PropertyName</MudTd>
            <MudTd>@context.OwnerName</MudTd>
            <MudTd>@context.City</MudTd>
        </RowTemplate>

        <NoRecordsContent>
            <MudText Color="Color.Secondary"
                Class="pa-4">
                @(IsLoading ? "Loading..." : "No record found.")
            </MudText>
        </NoRecordsContent>

        <PagerContent>
            @* <MudTablePager PageSizeOptions="new int[] { 5, 10, 20, 50, 100, 200, 500 }" /> *@
            <MudTablePager PageSizeOptions="new int[] { 5 }" />
        </PagerContent>

    </MudTable>
</MudPaper>



<MudPaper Class="pa-4">
    <MudText Typo="Typo.h6" Class="mb-3">
        Recent Flats/Units(Top 5)
    </MudText>
    <MudTable Items="_units"
                Hover="true"
                Dense="true"
                Striped="true"
                Bordered="true"
                RowsPerPage="5">
        <HeaderContent>
            <MudTh>Name</MudTh>
            <MudTh>Type</MudTh>
            <MudTh>Area(SqFt)</MudTh>
            <MudTh>Rent(₹)</MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd>@context.PropertyName</MudTd>
            <MudTd>@context.UnitType</MudTd>
            <MudTd>@context.Area</MudTd>
            <MudTd>@context.MonthlyRent</MudTd>
        </RowTemplate>

        <NoRecordsContent>
            <MudText Color="Color.Secondary"
                Class="pa-4">
                @(IsLoading ? "Loading..." : "No record found.")
            </MudText>
        </NoRecordsContent>
        <PagerContent>
            @* <MudTablePager PageSizeOptions="new int[] { 5, 10, 20, 50, 100, 200, 500 }" /> *@
            <MudTablePager PageSizeOptions="new int[] { 5 }" />
        </PagerContent>
    </MudTable>
    
</MudPaper>




<MudPaper Class="pa-4">
    <MudText Typo="Typo.h6" Class="mb-3">
        Recent Tenants(Top 5)
    </MudText>
    <MudTable Items="_tenants"
                Hover="true"
                Dense="true"
                Striped="true"
                Bordered="true"
                RowsPerPage="5">
        <HeaderContent>
            <MudTh>Name</MudTh>
            <MudTh>Phone</MudTh>
            <MudTh>Property</MudTh>
            <MudTh>Rent(₹)</MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd>@context.FirstName @context.LastName</MudTd>
            <MudTd>@context.PhoneNumber</MudTd>
            <MudTd>@context.PropertyName</MudTd>
            <MudTd>@context.MonthlyRent</MudTd>
        </RowTemplate>

        <NoRecordsContent>
            <MudText Color="Color.Secondary"
                Class="pa-4">
                @(IsLoading ? "Loading..." : "No record found.")
            </MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager PageSizeOptions="new int[] { 5 }" />
        </PagerContent>
    </MudTable>
</MudPaper>
@if (IsLoading)
{
    <CustomLoaderComponent />
}
